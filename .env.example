# Chep tep nay thanh `.env` roi dien khoa that vao.
# `.env` nam ngoai git (xem .gitignore) — khoa khong bao gio di vao lich su ma nguon.

# Khoa Gemini — lay o https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Tuy chon: doi mo hinh mac dinh
# Chi nhan gemini-3.8-flash — ten khac se bi ma tu choi ngay khi khoi dong.
# EIDE_MODEL_MAIN=gemini-3.8-flash
