(export (version "E")
  (design (source "eide") (tool "EIDE"))
  (components
    (comp (ref "BUTTON") (libsource (lib "eide-sinh") (part "BUTTON")))
    (comp (ref "BUZZER") (libsource (lib "eide-sinh") (part "BUZZER")))
    (comp (ref "JQ6500") (libsource (lib "eide-sinh") (part "JQ6500")))
    (comp (ref "R_DIVIDER") (libsource (lib "eide-sinh") (part "R_DIVIDER")))
    (comp (ref "SRF04") (libsource (lib "eide-sinh") (part "SRF04")))
    (comp (ref "U1") (value "ATmega328P") (libsource (lib "eide-sinh") (part "ATmega328P")))
    (comp (ref "U2") (value "A4988") (libsource (lib "eide-sinh") (part "A4988")))
    (comp (ref "U3") (value "A4988") (libsource (lib "eide-sinh") (part "A4988")))
    (comp (ref "U4") (value "MPU6050") (libsource (lib "eide-sinh") (part "MPU6050")))
    (comp (ref "WS2812") (libsource (lib "eide-sinh") (part "WS2812")))
  )
  (nets
    (net (code "1") (name "+5V")
      (node (ref "U2") (pin "MS1"))
      (node (ref "U2") (pin "MS2"))
      (node (ref "U2") (pin "MS3"))
      (node (ref "U2") (pin "VDD"))
      (node (ref "U3") (pin "MS1"))
      (node (ref "U3") (pin "MS2"))
      (node (ref "U3") (pin "MS3"))
      (node (ref "U3") (pin "VDD"))
    )
    (net (code "2") (name "ADC_BAT")
      (node (ref "R_DIVIDER") (pin "ADC_OUT"))
      (node (ref "U1") (pin "A0"))
    )
    (net (code "3") (name "BUTTON")
      (node (ref "BUTTON") (pin "OUT"))
      (node (ref "U1") (pin "D12"))
    )
    (net (code "4") (name "BUZZER")
      (node (ref "BUZZER") (pin "IN"))
      (node (ref "U1") (pin "D10"))
    )
    (net (code "5") (name "DIR1")
      (node (ref "U1") (pin "D4"))
      (node (ref "U2") (pin "DIR"))
    )
    (net (code "6") (name "DIR2")
      (node (ref "U1") (pin "D6"))
      (node (ref "U3") (pin "DIR"))
    )
    (net (code "7") (name "GND")
      (node (ref "U2") (pin "EN"))
      (node (ref "U2") (pin "GND"))
      (node (ref "U3") (pin "EN"))
      (node (ref "U3") (pin "GND"))
    )
    (net (code "8") (name "JQ6500_RX")
      (node (ref "JQ6500") (pin "RX"))
      (node (ref "U1") (pin "D1"))
    )
    (net (code "9") (name "JQ6500_TX")
      (node (ref "JQ6500") (pin "TX"))
      (node (ref "U1") (pin "D0"))
    )
    (net (code "10") (name "RST_SLP1")
      (node (ref "U2") (pin "RST"))
      (node (ref "U2") (pin "SLP"))
    )
    (net (code "11") (name "RST_SLP2")
      (node (ref "U3") (pin "RST"))
      (node (ref "U3") (pin "SLP"))
    )
    (net (code "12") (name "SCL")
      (node (ref "U1") (pin "A5"))
      (node (ref "U4") (pin "SCL"))
    )
    (net (code "13") (name "SDA")
      (node (ref "U1") (pin "A4"))
      (node (ref "U4") (pin "SDA"))
    )
    (net (code "14") (name "SRF04_ECHO")
      (node (ref "SRF04") (pin "ECHO"))
      (node (ref "U1") (pin "D2"))
    )
    (net (code "15") (name "SRF04_TRIG")
      (node (ref "SRF04") (pin "TRIG"))
      (node (ref "U1") (pin "D3"))
    )
    (net (code "16") (name "STEP1")
      (node (ref "U1") (pin "D5"))
      (node (ref "U2") (pin "STEP"))
    )
    (net (code "17") (name "STEP2")
      (node (ref "U1") (pin "D7"))
      (node (ref "U3") (pin "STEP"))
    )
    (net (code "18") (name "VMOT")
      (node (ref "U2") (pin "VMOT"))
      (node (ref "U3") (pin "VMOT"))
    )
    (net (code "19") (name "WS2812_DIN")
      (node (ref "U1") (pin "D11"))
      (node (ref "WS2812") (pin "DIN"))
    )
  )
)
